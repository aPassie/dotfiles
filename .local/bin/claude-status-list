#!/bin/bash
# Prints every live Claude Code session's status file as one JSON array (for the bar).
# Drops the file of a session whose Claude process is gone.
D="${XDG_STATE_HOME:-$HOME/.local/state}/claude-status"
shopt -s nullglob
live=()
for f in "$D"/*.json; do
    pid=$(jq -r '.pid // 0' "$f" 2>/dev/null) || { rm -f "$f"; continue; }
    if [ "${pid:-0}" -gt 0 ] && ! kill -0 "$pid" 2>/dev/null; then rm -f "$f"; continue; fi
    live+=("$f")
done
if [ ${#live[@]} -eq 0 ]; then echo '[]'; else jq -cs . "${live[@]}"; fi
