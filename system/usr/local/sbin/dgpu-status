#!/bin/bash
# Print current dGPU state (non-root friendly): off | compute | display | present
DGPU="0000:01:00.0"
[ -e "/sys/bus/pci/devices/${DGPU}" ] || { echo off; exit 0; }
lsmod | grep -q '^nvidia_drm' && { echo display; exit 0; }
lsmod | grep -q '^nvidia '    && { echo compute; exit 0; }
echo present
