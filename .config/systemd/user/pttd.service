[Unit]
Description=Push-to-talk dictation daemon (Parakeet Redux)
After=graphical-session.target pipewire.service
PartOf=graphical-session.target

[Service]
ExecStart=%h/.local/share/ptt/.venv/bin/python %h/.local/share/ptt/pttd.py
Environment=HF_HUB_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 PYTHONUNBUFFERED=1
# low priority so transcription never makes the desktop stutter
Nice=5
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
