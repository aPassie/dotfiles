// ─────────────────────────────────────────────────────────────────────────────
// 55 — Noctalia shell
// ─────────────────────────────────────────────────────────────────────────────
// Quickshell-based desktop shell (bar, launcher, notifications, lock, control
// center). Installed via the `noctalia-shell` package; entry point is
// /etc/xdg/quickshell/noctalia-shell/shell.qml.
//
// To uninstall: delete this file, remove its include line from config.kdl,
// then `pacman -Rns noctalia-shell noctalia-qs`.
// ─────────────────────────────────────────────────────────────────────────────

// `-d` daemonizes so noctalia detaches from niri's stdout/stderr.
// `--no-duplicate` is on by default — re-spawn attempts are skipped silently.
spawn-at-startup "qs" "-c" "noctalia-shell" "-d"
