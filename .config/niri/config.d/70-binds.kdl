// ─────────────────────────────────────────────────────────────────────────────
// 70 — Keybindings (bare niri defaults + system actions)
// ─────────────────────────────────────────────────────────────────────────────
// Mod = Super (Windows key). Mod+Shift+Slash shows this overlay.

binds {
    // ── Help / quit ─────────────────────────────────────────────────────────
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Shift+E     { quit; }

    // ── Apps ────────────────────────────────────────────────────────────────
    Mod+T      hotkey-overlay-title="Open a Terminal: foot" { spawn "footclient"; }
    Mod+Return hotkey-overlay-title="Open a Terminal: foot" { spawn "footclient"; }
    Mod+Space  hotkey-overlay-title="App Launcher"          { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "launcher" "toggle"; }
    Mod+E      hotkey-overlay-title="File Manager: nautilus" { spawn "nautilus"; }
    Mod+Q      hotkey-overlay-title="Close Window"          { close-window; }

    // ── Noctalia panels ─────────────────────────────────────────────────────
    Mod+P      hotkey-overlay-title="Control Center"        { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "controlCenter" "toggle"; }
    Mod+N      hotkey-overlay-title="Notification History"  { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "notifications" "toggleHistory"; }
    Mod+I      hotkey-overlay-title="Idle Inhibitor (Caffeine)" { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "idleInhibitor" "toggle"; }
    Mod+Y      hotkey-overlay-title="Clipboard history"        { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "launcher" "clipboard"; }

    // ── Audio ───────────────────────────────────────────────────────────────
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.5" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute        allow-when-locked=true { spawn "wpctl" "set-mute"   "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "wpctl" "set-mute"   "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86AudioPlay        allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPause       allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext        allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev        allow-when-locked=true { spawn "playerctl" "previous"; }

    // ── Brightness ──────────────────────────────────────────────────────────
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }

    // ── Screenshots ─────────────────────────────────────────────────────────
    // Region + screen go through grim → satty for annotation.
    // Window uses niri's built-in (saves directly, no annotation).
    Mod+Shift+S        hotkey-overlay-title="Screenshot region (annotate)"  { spawn "/usr/local/bin/screenshot-region"; }
    Mod+Ctrl+Shift+S   hotkey-overlay-title="Screenshot screen (annotate)"  { spawn "/usr/local/bin/screenshot-screen"; }
    Mod+Alt+Shift+S    hotkey-overlay-title="Screenshot focused window"     { screenshot-window; }
    Print      { spawn "/usr/local/bin/screenshot-region"; }
    Ctrl+Print { spawn "/usr/local/bin/screenshot-screen"; }
    Alt+Print  { screenshot-window; }

    // ── Focus ───────────────────────────────────────────────────────────────
    Mod+Left  { focus-column-or-monitor-left; }
    Mod+Right { focus-column-or-monitor-right; }
    Mod+Up    { focus-window-or-workspace-up; }
    Mod+Down  { focus-window-or-workspace-down; }
    Mod+H     { focus-column-or-monitor-left; }
    Mod+L     { focus-column-or-monitor-right; }
    Mod+K     { focus-window-or-workspace-up; }
    Mod+J     { focus-window-or-workspace-down; }

    // ── Move ────────────────────────────────────────────────────────────────
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+L     { move-column-right; }
    Mod+Shift+K     { move-window-up; }
    Mod+Shift+J     { move-window-down; }

    // ── Monitors ────────────────────────────────────────────────────────────
    Mod+Ctrl+Left  { focus-monitor-left; }
    Mod+Ctrl+Right { focus-monitor-right; }
    Mod+Ctrl+Up    { focus-monitor-up; }
    Mod+Ctrl+Down  { focus-monitor-down; }

    // ── Workspaces ──────────────────────────────────────────────────────────
    Mod+Page_Down       { focus-workspace-down; }
    Mod+Page_Up         { focus-workspace-up; }
    Mod+Shift+Page_Down { move-column-to-workspace-down; }
    Mod+Shift+Page_Up   { move-column-to-workspace-up; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // ── Column sizing ───────────────────────────────────────────────────────
    Mod+R           { switch-preset-column-width; }
    Mod+Shift+R     { reset-window-height; }
    Mod+F hotkey-overlay-title="Maximize (smart: column / fill-floating)" { spawn "/usr/local/bin/niri-smart-maximize"; }
    Mod+Shift+F     { fullscreen-window; }
    Mod+C           { center-column; }
    Mod+Minus       { set-column-width "-10%"; }
    Mod+Equal       { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // ── Consume / expel ─────────────────────────────────────────────────────
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma        { consume-window-into-column; }
    Mod+Period       { expel-window-from-column; }

    // ── Overview ────────────────────────────────────────────────────────────
    Mod+O { toggle-overview; }

    // ── Float / tabbed ──────────────────────────────────────────────────────
    // Float the window, resize to a small centered box (1000×700), center it.
    Mod+V hotkey-overlay-title="Float as small centered box" { spawn "bash" "-c" "niri msg action toggle-window-floating; niri msg action set-column-width 1000; niri msg action set-window-height 700; niri msg action center-column"; }
    Mod+Shift+V hotkey-overlay-title="Toggle floating (keep size)" { toggle-window-floating; }
    Mod+W { toggle-column-tabbed-display; }

    // ── Lock ────────────────────────────────────────────────────────────────
    Mod+Alt+L hotkey-overlay-title="Lock Screen" { spawn "hyprlock"; }
}

// ── Alt+Tab (built-in recent-windows) ───────────────────────────────────────
recent-windows {
    binds {
        Alt+Tab       { next-window scope="output"; }
        Alt+Shift+Tab { previous-window scope="output"; }
    }
}
